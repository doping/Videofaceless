# ============================================================
# The Silent Strategist - Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys

# OpenAI API Key (Required - for script generation and TTS)
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs API Key (Optional - for premium voiceover quality)
# If not set, OpenAI TTS will be used as fallback
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Pexels API Key (Optional - for stock video footage)
# Get free key at: https://www.pexels.com/api/
# If not set, dark placeholder clips will be generated
PEXELS_API_KEY=your-pexels-key-here
